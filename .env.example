# Public client configuration (Dart --dart-define or ignored config.cloud.json).
API_URL=
COVERS_PROXY_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Administration tools / GitHub Secrets only. NEVER compile into the client.
# Configure either the management token or the PostgreSQL URI.
SUPABASE_ACCESS_TOKEN=
WAVEIFY_DATABASE_URL=
# Optional when a management token can obtain the server storage key.
SUPABASE_SERVICE_ROLE_KEY=
# At least 20 characters; retain separately to decrypt backups.
WAVEIFY_BACKUP_PASSPHRASE=
