CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y

# MotoLink defaults
CONFIG_MOTOLINK_GNSS_ENABLED=n
CONFIG_MOTOLINK_GNSS_RX=4
CONFIG_MOTOLINK_GNSS_BAUD=9600
CONFIG_MOTOLINK_IMU_ENABLED=n
CONFIG_MOTOLINK_IMU_SPI_HOST=2
CONFIG_MOTOLINK_IMU_CS=5
CONFIG_MOTOLINK_IMU_INT=6
CONFIG_MOTOLINK_BLE_ENABLED=y
CONFIG_MOTOLINK_BLE_DEVICE_NAME="MotoLink"
CONFIG_MOTOLINK_BLE_CLIENT_ENABLED=y
CONFIG_MOTOLINK_BLE_CLIENT_NAME="MotoCAN"
CONFIG_MOTOLINK_STORAGE_ENABLED=n
CONFIG_MOTOLINK_STORAGE_SLOT=0
CONFIG_MOTOLINK_CAN_ENABLED=n
CONFIG_MOTOLINK_CAN_TX=7
CONFIG_MOTOLINK_CAN_RX=8
CONFIG_MOTOLINK_CAN_BITRATE=500000
CONFIG_MOTOLINK_LED_GPIO=2
CONFIG_MOTOLINK_LED_ACTIVE_HIGH=n
CONFIG_MOTOLINK_BTN_GPIO=0
CONFIG_MOTOLINK_BTN_ACTIVE_LOW=y
CONFIG_MOTOLINK_POWER_MONITOR=y
CONFIG_MOTOLINK_POWER_ADC_CHANNEL=0

# BLE
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CONTROLLER_MODE_BLE_ONLY=y

# Storage
CONFIG_FATFS_LONG_FILENAMES=y
CONFIG_FATFS_MAX_LFN=255

# TWAI (disabled on Core, used on Adapter)
CONFIG_TWAI_ENABLED=n
CONFIG_TWAI_ISR_IRAM_SAFE=y

# ADC
CONFIG_ADC_ONESHOT_EN=y
CONFIG_ADC_CALIBRATION_EN=y
